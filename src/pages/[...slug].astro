---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { pages, childrenOf, type Page } from '../lib/content';
export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
interface Props { page: Page }
const { page } = Astro.props;
const children = page.listing ? childrenOf(page.slug) : [];
---
<Layout title={`${page.title} — Tricky Tactics`}>
  <main id="main" class="container content-page">
    <a class="text-link" href="/">← Back to Tricky Tactics</a>
    <h1>{page.title}</h1>
    {page.releaseDate && <p class="article-date">Release date: <time datetime={page.releaseDate}>{page.releaseDate}</time></p>}
    {page.image && <img class="article-image" src={page.image} alt={page.title} />}
    <div class="prose" set:html={page.html} />
    {page.listing && <div class="article-list">{children.map((child) => <a href={`/${child.slug}/`}>{child.image && <img src={child.image} alt="" loading="lazy" />}<span>{child.title}{child.releaseDate && <time datetime={child.releaseDate}>{child.releaseDate}</time>}</span><Arrow /></a>)}{children.length === 0 && <p>No published updates yet. Follow along on <a class="text-link" href="https://discord.gg/77vxzeYKTG">Discord <Arrow diagonal /></a>.</p>}</div>}
  </main>
</Layout>
