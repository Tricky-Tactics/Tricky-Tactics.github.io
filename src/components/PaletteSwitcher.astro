---
// Temporary tool for comparing colour palettes on the live site; remove once a palette is chosen.
const palettes = [
  { id: 'night', name: 'Night & blue (current)' },
  { id: 'royal', name: 'Royal red' },
  { id: 'village', name: 'Village green' },
  { id: 'wormwood', name: 'Wormwood purple' },
  { id: 'barrel', name: 'Barrel wood' },
  { id: 'ink', name: 'Black & white, red accent' },
  { id: 'ink-red', name: 'Black & white, red panels' },
  { id: 'ink-crimson', name: 'B&W, crimson panels + red accent' },
  { id: 'ink-blue', name: 'B&W, game-blue panels + red accent' },
  { id: 'ink-paper', name: 'B&W, white hero + red accent' },
];
---
<div class="palette-switcher" role="group" aria-label="Colour palette">
  <span>Palette</span>
  {palettes.map((palette) => <button type="button" data-palette={palette.id}>{palette.name}</button>)}
  <span>Grid</span>
  <button type="button" class="grid-toggle" aria-pressed="true">On</button>
</div>

<script is:inline>
  (() => {
    const key = 'tt-palette';
    const fromUrl = new URLSearchParams(location.search).get('palette');
    let saved = null;
    try { saved = localStorage.getItem(key); } catch {}
    const apply = (id) => {
      document.documentElement.dataset.palette = id;
      document.querySelectorAll('.palette-switcher [data-palette]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.palette === id)));
      try { localStorage.setItem(key, id); } catch {}
    };
    apply(fromUrl || saved || 'night');
    document.querySelectorAll('.palette-switcher [data-palette]').forEach((b) => b.addEventListener('click', () => apply(b.dataset.palette)));

    const gridKey = 'tt-grid';
    const toggle = document.querySelector('.grid-toggle');
    const setGrid = (on) => {
      document.documentElement.dataset.grid = on ? 'on' : 'off';
      toggle.setAttribute('aria-pressed', String(on));
      toggle.textContent = on ? 'On' : 'Off';
      try { localStorage.setItem(gridKey, on ? 'on' : 'off'); } catch {}
    };
    let savedGrid = null;
    try { savedGrid = localStorage.getItem(gridKey); } catch {}
    setGrid((new URLSearchParams(location.search).get('grid') || savedGrid) !== 'off');
    toggle.addEventListener('click', () => setGrid(document.documentElement.dataset.grid === 'off'));
  })();
</script>

<style is:global>
  [data-grid='off'] .checker { background-image: none; }

  /* Palettes drawn from the game: deck-screen red, board grass, Hexcaster purple, explosive-barrel wood. */
  [data-palette='royal'] {
    --night: #2a0a14; --night-2: #3d1120; --night-3: #521a2c;
    --blue: #b3202f; --blue-deep: #8c1825;
    --on-blue: #ffe1df; --on-blue-muted: #f6c2bf; --on-blue-faint: #e28f8a;
    --on-dark-muted: #d1a8ad; --nav-link: #f0d6d9; --header-bg: #2a0a14f2; --shadow: #3a0a1066;
  }
  [data-palette='village'] {
    --night: #0d2318; --night-2: #163424; --night-3: #1f4630;
    --blue: #3a8f37; --blue-deep: #2c712a;
    --on-blue: #e6f8dc; --on-blue-muted: #c7e9b8; --on-blue-faint: #94cf80;
    --on-dark-muted: #a9c9b3; --nav-link: #d6eadb; --header-bg: #0d2318f2; --shadow: #0b2a1066;
    --lime: #ffcf3a;
  }
  [data-palette='wormwood'] {
    --night: #170d2b; --night-2: #24163f; --night-3: #321f57;
    --blue: #6a3fb8; --blue-deep: #52309a;
    --accent: #7be06b; --accent-hover: #9aeb8d;
    --on-blue: #ece2ff; --on-blue-muted: #d3c2f5; --on-blue-faint: #a98ee0;
    --on-dark-muted: #b6aad0; --nav-link: #ddd4ee; --header-bg: #170d2bf2; --shadow: #1a0a3a66;
    --lime: #7be06b;
  }
  [data-palette='barrel'] {
    --night: #24130b; --night-2: #351d11; --night-3: #4a2918;
    --blue: #d0681c; --blue-deep: #a85214;
    --accent: #ffe36b; --accent-hover: #ffeb94;
    --on-blue: #fff0e2; --on-blue-muted: #ffd9b8; --on-blue-faint: #f0a970;
    --on-dark-muted: #cdb3a3; --nav-link: #eedccf; --header-bg: #24130bf2; --shadow: #3a1a0866;
  }

  /* Black and white, with red reserved for highlights (ink) or also the feature panels (ink-red). */
  [data-palette^='ink'] {
    --night: #0a0a0a; --night-2: #1a1a1a; --night-3: #2a2a2a;
    --blue: #1c1c1c; --blue-deep: #111111;
    --accent: #e8282b; --accent-hover: #ff4245; --lime: #e8282b;
    --gray: #f2f2f2; --line: #e2e2e2; --muted: #5f5f5f; --surface-hover: #e8e8e8;
    --on-dark-muted: #a8a8a8; --on-blue: #ececec; --on-blue-muted: #c4c4c4; --on-blue-faint: #8a8a8a;
    --nav-link: #d8d8d8; --header-bg: #0a0a0af2; --shadow: #00000066;
  }
  [data-palette='ink-red'] {
    --blue: #d42326; --blue-deep: #a8181b;
    --accent: #ffffff; --accent-hover: #ffd9d9;
    --on-blue: #ffe6e6; --on-blue-muted: #ffc9c9; --on-blue-faint: #ff9a9a;
    --shadow: #40000066;
  }
  /* A white tint over red reads as pink; shade the board tiles darker instead. */
  [data-palette='ink-red'] .checker { --tile: #0000000d; }

  /* Red accent everywhere, but white on the coloured panels so it never sits red-on-red. */
  [data-palette='ink-crimson'] { --blue: #8f1519; --blue-deep: #6e0f12; --on-blue: #ffe3e3; --on-blue-muted: #f2bcbc; --on-blue-faint: #d98585; --shadow: #2a000066; }
  [data-palette='ink-crimson'] .checker { --tile: #0000001a; }
  [data-palette='ink-blue'] { --blue: #0e65ba; --blue-deep: #0a4e93; --on-blue: #dcebff; --on-blue-muted: #c4dbf7; --on-blue-faint: #8fb5e0; --shadow: #0a2a5566; }
  [data-palette='ink-crimson'] :is(.hero-section, .squad-feature, .community-section),
  [data-palette='ink-blue'] :is(.hero-section, .squad-feature, .community-section) { --accent: #ffffff; --accent-hover: #ececec; --lime: #ffffff; }
  [data-palette='ink-blue'] .serif-accent { color: var(--accent); }
  /* Paper: the hero flips to white so it separates from the black gameplay band below. */
  [data-palette='ink-paper'] .hero-section { --blue: #ffffff; --white: #0a0a0a; --on-blue: #333333; --on-blue-muted: #5f5f5f; --on-blue-faint: #a0a0a0; --tile: #0000000a; --shadow: #00000040; border-bottom: 1px solid #e6e6e6; }
  [data-palette='ink-paper'] .hero-section .play-icon { background: #0000000f; }

  .palette-switcher { position: fixed; left: 12px; bottom: 12px; z-index: 1000; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; max-width: calc(100vw - 24px); padding: 8px; background: #fff; color: #111; border-radius: 14px; box-shadow: 0 8px 30px #0005; font: 600 12px/1 system-ui, sans-serif; }
  .palette-switcher span { padding-inline: 6px; opacity: .6; }
  .palette-switcher button { padding: 8px 10px; border: 1px solid #ddd; border-radius: 999px; background: #fff; color: inherit; font: inherit; cursor: pointer; }
  .palette-switcher button[aria-pressed='true'] { background: #111; color: #fff; border-color: #111; }
</style>
